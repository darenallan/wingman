PORT=3000

# Accès (obligatoires : le serveur refuse de démarrer sans eux)
# Mot de passe demandé à l'ouverture de l'app (12 caractères minimum)
WINGMAN_PASSWORD=
# Secret de signature des sessions : openssl rand -base64 48
SESSION_SECRET=
# Optionnel : nombre maximal de générations par jour, tous appareils confondus (défaut 300)
GENERATE_DAILY_LIMIT=

DATABASE_URL=postgresql://user:password@ep-hostname.region.aws.neon.tech/neondb?sslmode=require

# Clé IA : le fournisseur est détecté automatiquement via le préfixe
#   gsk_...  → Groq (gratuit)   |   AIza... → Gemini   |   sk-... → OpenAI
AI_API_KEY=sk-proj-votre-cle-api

# Optionnel : vide = auto (Groq si clé gsk_, Gemini si AIza, sinon OpenAI)
# ex. https://api.groq.com/openai/v1/chat/completions
AI_BASE_URL=

# Optionnel : vide = modèle par défaut du fournisseur
# (groq: openai/gpt-oss-120b, gemini: gemini-2.5-flash, openai: gpt-4o-mini)
AI_MODEL=
